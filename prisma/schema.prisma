/// 지역 뉴스 모델
model local_news {
  id          String   @id(map: "local_news_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  title       String   @db.VarChar(500)
  summary     String?
  link        String   @db.VarChar(1000)
  source      String   @db.VarChar(100)
  category    String   @db.VarChar(50)
  regionCode  String   @db.VarChar(20)
  publishedAt DateTime @db.Timestamp(6)
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  @@index([regionCode, publishedAt], map: "idx_local_news_region")
}

/// 대기질 예보통보 모델
model air_quality_forecast {
  id             String   @id(map: "air_quality_forecast_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  sido_name      String   @db.VarChar(50)  // 시도명
  inform_code    String   @db.VarChar(10)  // 통보코드 (PM10, PM25, O3)
  forecast_date  DateTime @db.Timestamp(6) // 예보 날짜
  publish_time   DateTime @db.Timestamp(6) // 발표 시간
  grade          Int      @db.SmallInt     // 등급 (1:좋음, 2:보통, 3:나쁨, 4:매우나쁨)
  inform_cause   String?                   // 발생 원인
  inform_overall String?                   // 예보 개황
  created_at     DateTime @default(now()) @db.Timestamp(6)

  @@unique([sido_name, inform_code, forecast_date], map: "uq_air_quality_forecast")
  @@index([sido_name, forecast_date], map: "idx_air_quality_forecast_sido")
}

/// 재난 알림 모델
model disaster_alert {
  id           String    @id(map: "disaster_alert_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  sn           Int       @unique // 일련번호 (API 고유 ID)
  msg_cn       String    // 메시지 내용
  rcptn_rgn_nm String    @db.VarChar(200)        // 수신 지역명
  crt_dt       DateTime? @db.Timestamp(6)        // 생성일시
  emrg_step_nm String    @db.VarChar(50)         // 긴급단계
  dst_se_nm    String    @db.VarChar(100)        // 재해구분명
  created_at   DateTime  @default(now()) @db.Timestamp(6)

  @@index([rcptn_rgn_nm, crt_dt], map: "idx_disaster_alert_region")
}

/// 돌발상황 정보 모델
model traffic_incidents {
  traffic_incident_id String                   @id(map: "traffic_incidents_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  incident_id         String                   @db.VarChar(100) // 외부 API 고유 ID
  type                String                   @db.VarChar(50)  // 사고, 공사, 행사 등
  title               String                   @db.VarChar(200)
  description         String?
  road_name           String?                  @db.VarChar(100)
  longitude           Float
  latitude            Float
  location            Unsupported("geometry")?
  start_time          DateTime                 @db.Timestamp(6)
  end_time            DateTime?                @db.Timestamp(6)
  severity            Int?                     @db.SmallInt // 심각도 1-3
  created_at          DateTime                 @default(now()) @db.Timestamp(6)

  @@unique([incident_id], map: "uq_traffic_incident_id")
  @@index([location], map: "idx_traffic_incidents_location", type: Gist)
}

/// 도로 소통 정보 모델
model road_traffic {
  road_traffic_id String                   @id(map: "road_traffic_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  road_name       String                   @db.VarChar(100)
  link_id         String?                  @db.VarChar(50)
  speed           Int?                     @db.SmallInt // 현재 속도 (km/h)
  status          Int                      @db.SmallInt // 1: 원활, 2: 서행, 3: 정체
  longitude       Float
  latitude        Float
  location        Unsupported("geometry")?
  data_time       DateTime                 @db.Timestamp(6)
  created_at      DateTime                 @default(now()) @db.Timestamp(6)

  @@index([road_name, data_time], map: "idx_road_traffic_road")
  @@index([location], map: "idx_road_traffic_location", type: Gist)
}

/// 긴급도 리포트 모델 (게시글 긴급도 분석 결과)
model urgency_report {
  urgencyReportId String   @id(map: "urgency_report_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  postId          String   @db.Uuid
  userId          String   @db.Uuid
  score           Float    @db.Real                 // 긴급도 점수 (0~10)
  level           String   @db.VarChar(20)          // urgent, caution, normal
  category        String?  @db.VarChar(50)          // naturalDisaster, accident, lifeSafety, health
  matchedKeywords String[] @default([])             // 매칭된 키워드 목록
  confidence      Float    @default(0) @db.Real     // 신뢰도 (0~1)
  longitude       Float?
  latitude        Float?
  isConfirmed     Boolean  @default(false)          // 사용자 확인 여부
  reportCount     Int      @default(0)              // 확인/신고 수
  createdAt       DateTime @default(now()) @db.Timestamp(6)

  post posts         @relation(fields: [postId], references: [post_id], onDelete: Cascade, onUpdate: NoAction, map: "urgency_report_posts_fk")
  user users_account @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "urgency_report_users_fk")

  @@index([postId], map: "idx_urgency_report_post")
  @@index([level, createdAt], map: "idx_urgency_report_level")
  @@index([userId], map: "idx_urgency_report_user")
}

/// 푸시 토큰 모델 (사용자 디바이스별 토큰 저장)
model push_token {
  id         String   @id(map: "push_token_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique @db.VarChar(500) // Expo Push Token
  deviceType String?  @db.VarChar(20) // ios, android, web
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @db.Timestamp(6)

  user users_account @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "push_token_users_fk")

  @@index([userId], map: "idx_push_token_user")
}

/// 알림 모델 (알림 히스토리)
model notification {
  id         String    @id(map: "notification_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @db.Uuid
  type       String    @db.VarChar(50) // disaster, comment, like, urgent_post
  title      String    @db.VarChar(200)
  body       String
  data       String?   // JSON 데이터 (postId, alertId 등)
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  readAt     DateTime? @db.Timestamp(6)

  user users_account @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "notification_users_fk")

  @@index([userId, createdAt], map: "idx_notification_user")
  @@index([userId, isRead], map: "idx_notification_unread")
}

/// 투표 모델
model poll {
  pollId      String    @id(map: "poll_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String    @db.Uuid
  title       String    @db.VarChar(200)
  description String?
  longitude   Float?
  latitude    Float?
  expiresAt   DateTime  @db.Timestamp(6)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)

  user    users_account @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "poll_users_fk")
  options poll_option[]

  @@index([userId], map: "idx_poll_user")
  @@index([isActive, expiresAt], map: "idx_poll_active")
}

/// 투표 선택지 모델
model poll_option {
  optionId  String   @id(map: "poll_option_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  pollId    String   @db.Uuid
  label     String   @db.VarChar(100)
  sortOrder Int      @default(0) @db.SmallInt
  createdAt DateTime @default(now()) @db.Timestamp(6)

  poll  poll        @relation(fields: [pollId], references: [pollId], onDelete: Cascade, onUpdate: NoAction, map: "poll_option_poll_fk")
  votes poll_vote[]

  @@index([pollId], map: "idx_poll_option_poll")
}

/// 투표 참여 모델
model poll_vote {
  voteId    String   @id(map: "poll_vote_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  pollId    String   @db.Uuid
  optionId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)

  option poll_option   @relation(fields: [optionId], references: [optionId], onDelete: Cascade, onUpdate: NoAction, map: "poll_vote_option_fk")
  user   users_account @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "poll_vote_users_fk")

  @@unique([pollId, userId], map: "uq_poll_vote_user")
  @@index([optionId], map: "idx_poll_vote_option")
}

