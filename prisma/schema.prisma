generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model air_quality {
  air_quality_id String   @id(map: "air_quality_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  station_name   String   @db.VarChar
  sido_name      String   @db.VarChar
  pm25_value     Int?     @db.SmallInt
  pm10_value     Int?     @db.SmallInt
  pm25_grade     Int?     @db.SmallInt
  pm10_grade     Int?     @db.SmallInt
  khai_grade     Int?     @db.SmallInt
  khai_value     Int?     @db.SmallInt
  o3_value       Float?   @db.Real
  co_value       Float?   @db.Real
  no2_value      Float?   @db.Real
  so2_value      Float?   @db.Real
  data_time      DateTime @db.Timestamp(6)
  created_at     DateTime @default(now()) @db.Timestamp(6)

  @@unique([station_name, data_time], map: "uq_air_quality_station_time")
  @@index([sido_name, data_time], map: "air_quality_sido_name_idx")
}

/// 댓글 모델
model comment {
  commentId String    @id(map: "comment_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  postId    String    @db.Uuid
  userId    String    @db.Uuid
  parentId  String?   @db.Uuid
  contents  String
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @db.Timestamp(6)

  // 관계
  post    posts         @relation(fields: [postId], references: [post_id], onDelete: Cascade, onUpdate: NoAction, map: "comment_posts_fk")
  user    users_account @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "comment_users_fk")
  parent  comment?      @relation("CommentReplies", fields: [parentId], references: [commentId], onDelete: Cascade, onUpdate: NoAction)
  replies comment[]     @relation("CommentReplies")

  @@index([postId, createdAt], map: "idx_comment_post")
  @@index([userId], map: "idx_comment_user")
}

/// 좋아요 모델
model post_like {
  likeId    String   @id(map: "post_like_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)

  // 관계
  post posts         @relation(fields: [postId], references: [post_id], onDelete: Cascade, onUpdate: NoAction, map: "post_like_posts_fk")
  user users_account @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "post_like_users_fk")

  @@unique([postId, userId], map: "uq_post_like_post_user")
  @@index([userId], map: "idx_post_like_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model media_storage {
  media_id   String    @id(map: "mediastorage_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  link       String?   @db.VarChar
  post_id    String    @db.Uuid
  type       String?   @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  posts      posts     @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction, map: "mediastorage_posts_fk")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model posts {
  post_id       String                   @id(map: "posts_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  user_id       String                   @db.Uuid
  created_at    DateTime?                @default(now()) @db.Timestamp(6)
  contents      String
  longitude     Float?
  latitude      Float?
  location      Unsupported("geometry")? @default(dbgenerated("st_setsrid(st_makepoint(longitude, latitude), 4326)"))
  media_storage media_storage[]
  comments      comment[]
  likes         post_like[]
  users_account users_account            @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "posts_users_account_fk")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model sig {
  gid        Int                     @id @default(autoincrement()) @db.SmallInt
  sig_cd     Int
  sig_eng_nm String                  @db.VarChar(40)
  sig_kor_nm String                  @db.VarChar(40)
  geom       Unsupported("geometry")
  sido_nm    String                  @db.VarChar(40)

  @@index([geom], type: Gist)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model users_account {
  user_id        String          @id(map: "users_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  username       String          @unique(map: "username_uq") @db.VarChar(255)
  password       String?         @db.VarChar(255)
  nickname       String?         @db.VarChar(255)
  provider       String          @default("local") @db.VarChar(255)
  sns_id         String?         @db.VarChar(255)
  posts          posts[]
  comments       comment[]
  likes          post_like[]
  users_location users_location?
  push_tokens    push_token[]
  notifications  notification[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users_location {
  user_id       String                   @id(map: "user_locations_pk") @db.Uuid
  longitude     Float?
  latitude      Float?
  location      Unsupported("geometry")? @default(dbgenerated("st_setsrid(st_makepoint(longitude, latitude), 4326)"))
  nx            Int?                     @default(dbgenerated("(kma_lonlat_to_grid(longitude, latitude)).nx")) @db.SmallInt
  ny            Int?                     @default(dbgenerated("(kma_lonlat_to_grid(longitude, latitude)).ny")) @db.SmallInt
  users_account users_account            @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "user_locations_users_fk")

  @@index([nx, ny, user_id], map: "idx_users_grid_cover")
}

model weather_short_term_forecast {
  weather_short_term_forecast_id String    @id(map: "weather_short_term_forecast_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  nx                             Int       @db.SmallInt
  ny                             Int       @db.SmallInt
  base_datetime                  DateTime  @db.Timestamp(6)
  fcst_datetime                  DateTime  @db.Timestamp(6)
  tmp                            Int?      @db.SmallInt
  uuu                            Int?      @db.SmallInt
  vvv                            Int?      @db.SmallInt
  vec                            Int?      @db.SmallInt
  wsd                            Int?      @db.SmallInt
  sky                            Int?      @db.SmallInt
  pty                            Int?      @db.SmallInt
  pop                            Int?      @db.SmallInt
  wav                            Int?      @db.SmallInt
  pcp                            Int?      @db.SmallInt
  reh                            Int?      @db.SmallInt
  sno                            Int?      @db.SmallInt
  tmn                            Int?      @db.SmallInt
  tmx                            Int?      @db.SmallInt
  created_at                     DateTime? @default(now()) @db.Timestamp(6)
  updated_at                     DateTime? @default(now()) @db.Timestamp(6)

  @@unique([nx, ny, fcst_datetime], map: "uq_weather_short_term_forecast")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model weather_ultra_short_term_forecast {
  weather_ultra_short_term_forecast_id String   @id(map: "weather_ultra_short_term_forecast_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  nx                                   Int      @db.SmallInt
  ny                                   Int      @db.SmallInt
  base_datetime                        DateTime @db.Timestamp(6)
  fcst_datetime                        DateTime @db.Timestamp(6)
  t1h                                  Int?     @db.SmallInt
  rn1                                  Int?     @db.SmallInt
  sky                                  Int?     @db.SmallInt
  uuu                                  Int?     @db.SmallInt
  vvv                                  Int?     @db.SmallInt
  reh                                  Int?     @db.SmallInt
  pty                                  Int?     @db.SmallInt
  lgt                                  Int?     @db.SmallInt
  vec                                  Int?     @db.SmallInt
  wsd                                  Int?     @db.SmallInt
  created_at                           DateTime @default(now()) @db.Timestamp(6)
  updated_at                           DateTime @default(now()) @db.Timestamp(6)

  @@unique([nx, ny, fcst_datetime], map: "uq_weather_forecast")
}

/// 지역 뉴스 모델
model local_news {
  id          String   @id(map: "local_news_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  title       String   @db.VarChar(500)
  summary     String?
  link        String   @db.VarChar(1000)
  source      String   @db.VarChar(100)
  category    String   @db.VarChar(50)
  regionCode  String   @db.VarChar(20)
  publishedAt DateTime @db.Timestamp(6)
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  @@index([regionCode, publishedAt], map: "idx_local_news_region")
}

/// 대기질 예보통보 모델
model air_quality_forecast {
  id             String   @id(map: "air_quality_forecast_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  sido_name      String   @db.VarChar(50)  // 시도명
  inform_code    String   @db.VarChar(10)  // 통보코드 (PM10, PM25, O3)
  forecast_date  DateTime @db.Timestamp(6) // 예보 날짜
  publish_time   DateTime @db.Timestamp(6) // 발표 시간
  grade          Int      @db.SmallInt     // 등급 (1:좋음, 2:보통, 3:나쁨, 4:매우나쁨)
  inform_cause   String?                   // 발생 원인
  inform_overall String?                   // 예보 개황
  created_at     DateTime @default(now()) @db.Timestamp(6)

  @@unique([sido_name, inform_code, forecast_date], map: "uq_air_quality_forecast")
  @@index([sido_name, forecast_date], map: "idx_air_quality_forecast_sido")
}

/// 재난 알림 모델
model disaster_alert {
  id           String    @id(map: "disaster_alert_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  sn           String    @unique @db.VarChar(50) // 일련번호 (API 고유 ID)
  msg_cn       String    // 메시지 내용
  rcptn_rgn_nm String    @db.VarChar(200)        // 수신 지역명
  crt_dt       DateTime? @db.Timestamp(6)        // 생성일시
  emrg_step_nm String    @db.VarChar(50)         // 긴급단계
  dst_se_nm    String    @db.VarChar(100)        // 재해구분명
  created_at   DateTime  @default(now()) @db.Timestamp(6)

  @@index([rcptn_rgn_nm, crt_dt], map: "idx_disaster_alert_region")
}

/// 돌발상황 정보 모델
model traffic_incidents {
  traffic_incident_id String                   @id(map: "traffic_incidents_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  incident_id         String                   @db.VarChar(100) // 외부 API 고유 ID
  type                String                   @db.VarChar(50)  // 사고, 공사, 행사 등
  title               String                   @db.VarChar(200)
  description         String?
  road_name           String?                  @db.VarChar(100)
  longitude           Float
  latitude            Float
  location            Unsupported("geometry")?
  start_time          DateTime                 @db.Timestamp(6)
  end_time            DateTime?                @db.Timestamp(6)
  severity            Int?                     @db.SmallInt // 심각도 1-3
  created_at          DateTime                 @default(now()) @db.Timestamp(6)

  @@unique([incident_id], map: "uq_traffic_incident_id")
  @@index([location], map: "idx_traffic_incidents_location", type: Gist)
}

/// 도로 소통 정보 모델
model road_traffic {
  road_traffic_id String                   @id(map: "road_traffic_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  road_name       String                   @db.VarChar(100)
  link_id         String?                  @db.VarChar(50)
  speed           Int?                     @db.SmallInt // 현재 속도 (km/h)
  status          Int                      @db.SmallInt // 1: 원활, 2: 서행, 3: 정체
  longitude       Float
  latitude        Float
  location        Unsupported("geometry")?
  data_time       DateTime                 @db.Timestamp(6)
  created_at      DateTime                 @default(now()) @db.Timestamp(6)

  @@index([road_name, data_time], map: "idx_road_traffic_road")
  @@index([location], map: "idx_road_traffic_location", type: Gist)
}

/// 푸시 토큰 모델 (사용자 디바이스별 토큰 저장)
model push_token {
  id         String   @id(map: "push_token_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique @db.VarChar(500) // Expo Push Token
  deviceType String?  @db.VarChar(20) // ios, android, web
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @db.Timestamp(6)

  user users_account @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "push_token_users_fk")

  @@index([userId], map: "idx_push_token_user")
}

/// 알림 모델 (알림 히스토리)
model notification {
  id         String    @id(map: "notification_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @db.Uuid
  type       String    @db.VarChar(50) // disaster, comment, like, urgent_post
  title      String    @db.VarChar(200)
  body       String
  data       String?   // JSON 데이터 (postId, alertId 등)
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  readAt     DateTime? @db.Timestamp(6)

  user users_account @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "notification_users_fk")

  @@index([userId, createdAt], map: "idx_notification_user")
  @@index([userId, isRead], map: "idx_notification_unread")
}

