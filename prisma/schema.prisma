// DB 연결 설정 (자동으로 생성됨)
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"] // PostGIS 등 확장기능 사용 시 필요
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis] // 사용하는 확장기능 명시 (postgis가 설치되어 있어야 함)
}

// ------------------------------------------------------
// 여기서부터 테이블 정의 (User 모델 예시)
// ------------------------------------------------------

/// 회원 계정 정보 (users_account)
model UserAccount {
  userId   String  @id @default(dbgenerated("uuidv7()")) @map("user_id") @db.Uuid
  username String  @unique @db.VarChar(255)
  password String? @db.VarChar(255)
  nickname String? @db.VarChar(255)
  provider String  @default("local") @db.VarChar(255)
  snsId    String? @map("sns_id") @db.VarChar(255)

  // 1:1 관계: 위치 정보
  location UserLocation?

  // 1:N 관계: 작성한 게시글
  posts Post[]

  // 1:N 관계: 작성한 댓글
  comments Comment[]

  // 1:N 관계: 좋아요
  likes PostLike[]

  @@map("users_account")
}

/// 회원 위치 정보 및 기상청 격자 (users_location)
model UserLocation {
  userId    String @id @map("user_id") @db.Uuid
  longitude Float?
  latitude  Float?

  // PostGIS Geometry 타입 (Prisma 미지원 -> Unsupported 처리)
  // DB에서 자동 생성되므로 데이터 삽입 시에는 무시됩니다.
  location Unsupported("geometry(point, 4326)")?

  // Generated Columns (기상청 격자)
  // DB에서 자동 계산되므로 삽입 시 값을 넣지 않습니다.
  nx Int? @db.SmallInt
  ny Int? @db.SmallInt

  // 관계 설정
  user UserAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("users_location")
}

/// 게시글 (posts)
model Post {
  postId    String    @id @default(dbgenerated("uuidv7()")) @map("post_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  contents  String    @db.Text
  longitude Float?
  latitude  Float?

  // Generated Columns (위치)
  location Unsupported("geometry(point, 4326)")?

  // 관계 설정
  user     UserAccount    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  media    MediaStorage[]
  comments Comment[]
  likes    PostLike[]

  @@map("posts")
}

/// 게시글 좋아요 (post_likes)
model PostLike {
  likeId    String   @id @default(dbgenerated("uuidv7()")) @map("like_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // 관계 설정
  post Post        @relation(fields: [postId], references: [postId], onDelete: Cascade)
  user UserAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([postId, userId], map: "uq_post_like")
  @@map("post_likes")
}

/// 댓글 (comments)
model Comment {
  commentId String    @id @default(dbgenerated("uuidv7()")) @map("comment_id") @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  contents  String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)

  // 관계 설정
  post     Post        @relation(fields: [postId], references: [postId], onDelete: Cascade)
  user     UserAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
  parent   Comment?    @relation("CommentReplies", fields: [parentId], references: [commentId], onDelete: Cascade)
  replies  Comment[]   @relation("CommentReplies")

  @@index([postId, createdAt])
  @@map("comments")
}

/// 미디어 저장소 (media_storage)
model MediaStorage {
  mediaId   String    @id @default(dbgenerated("uuidv7()")) @map("media_id") @db.Uuid
  link      String?   @db.VarChar
  postId    String    @map("post_id") @db.Uuid
  type      String?   @db.VarChar(20)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // 관계 설정
  post Post @relation(fields: [postId], references: [postId], onDelete: Cascade)

  @@map("media_storage")
}

model WeatherUltraShortTermForecast {
  id           String   @id @default(dbgenerated("uuidv7()")) @map("weather_ultra_short_term_forecast_id") @db.Uuid
  nx           Int      @db.SmallInt
  ny           Int      @db.SmallInt
  baseDatetime DateTime @map("base_datetime") @db.Timestamp(6)
  fcstDatetime DateTime @map("fcst_datetime") @db.Timestamp(6)
  
  // 날씨 데이터 필드들
  t1h Int? @db.SmallInt
  rn1 Int? @db.SmallInt
  sky Int? @db.SmallInt
  uuu Int? @db.SmallInt
  vvv Int? @db.SmallInt
  reh Int? @db.SmallInt
  pty Int? @db.SmallInt
  lgt Int? @db.SmallInt
  vec Int? @db.SmallInt
  wsd Int? @db.SmallInt
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  // 복합 유니크 키 설정
  @@unique([nx, ny, fcstDatetime], map: "uq_weather_forecast")
  @@map("weather_ultra_short_term_forecast")
}

model WeatherShortTermForecast {
  id           String   @id @default(dbgenerated("uuidv7()")) @map("weather_short_term_forecast_id") @db.Uuid
  nx           Int      @db.SmallInt
  ny           Int      @db.SmallInt
  baseDatetime DateTime @map("base_datetime") @db.Timestamp(6)
  fcstDatetime DateTime @map("fcst_datetime") @db.Timestamp(6)
  
  // 날씨 데이터 필드들
  tmp  Int? @db.SmallInt
  uuu  Int? @db.SmallInt
  vvv  Int? @db.SmallInt
  vec  Int? @db.SmallInt
  wsd  Int? @db.SmallInt
  sky  Int? @db.SmallInt
  pty  Int? @db.SmallInt
  pop  Int? @db.SmallInt
  wav  Int? @db.SmallInt
  pcp  Int? @db.SmallInt
  reh  Int? @db.SmallInt
  sno  Int? @db.SmallInt
  tmn  Int? @db.SmallInt
  tmx  Int? @db.SmallInt
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  // 복합 유니크 키 설정
  @@unique([nx, ny, fcstDatetime], map: "uq_weather_short_term_forecast")
  @@map("weather_short_term_forecast")
}

model Sig {
  gid        Int      @id @default(dbgenerated("nextval('sig_gid_seq'::regclass)")) @db.SmallInt
  sigCd      Int     @map("sig_cd") @db.Integer
  sigEngNm   String  @map("sig_eng_nm") @db.VarChar(40)
  sigKorNm   String  @map("sig_kor_nm") @db.VarChar(40)
  geom       Unsupported("geometry(multipolygon, 4326)")
  sidoNm     String  @map("sido_nm") @db.VarChar(40)

  @@map("sig")
}

/// 대기질 측정 정보 (air_quality)
model AirQuality {
  id          String   @id @default(dbgenerated("uuidv7()")) @map("air_quality_id") @db.Uuid
  stationName String   @map("station_name") @db.VarChar(100)
  sidoName    String   @map("sido_name") @db.VarChar(40)
  pm25Value   Int?     @map("pm25_value") @db.SmallInt
  pm10Value   Int?     @map("pm10_value") @db.SmallInt
  pm25Grade   Int?     @map("pm25_grade") @db.SmallInt
  pm10Grade   Int?     @map("pm10_grade") @db.SmallInt
  khaiGrade   Int?     @map("khai_grade") @db.SmallInt
  khaiValue   Int?     @map("khai_value") @db.SmallInt
  o3Value     Float?   @map("o3_value")
  coValue     Float?   @map("co_value")
  no2Value    Float?   @map("no2_value")
  so2Value    Float?   @map("so2_value")
  dataTime    DateTime @map("data_time") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([stationName, dataTime], map: "uq_air_quality_station_time")
  @@index([sidoName, dataTime])
  @@map("air_quality")
}

/// 교통 돌발상황 정보 (traffic_incidents)
model TrafficIncident {
  id          String    @id @default(dbgenerated("uuidv7()")) @map("traffic_incident_id") @db.Uuid
  incidentId  String    @unique @map("incident_id") @db.VarChar(50)
  type        String    @map("type") @db.VarChar(20)
  title       String    @map("title") @db.VarChar(200)
  description String?   @map("description") @db.Text
  roadName    String?   @map("road_name") @db.VarChar(100)
  longitude   Float
  latitude    Float
  location    Unsupported("geometry(point, 4326)")?
  startTime   DateTime  @map("start_time") @db.Timestamp(6)
  endTime     DateTime? @map("end_time") @db.Timestamp(6)
  severity    Int?      @map("severity") @db.SmallInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([longitude, latitude])
  @@index([type, startTime])
  @@map("traffic_incidents")
}

/// 도로 소통정보 (road_traffic)
model RoadTraffic {
  id        String   @id @default(dbgenerated("uuidv7()")) @map("road_traffic_id") @db.Uuid
  roadName  String   @map("road_name") @db.VarChar(100)
  linkId    String?  @map("link_id") @db.VarChar(50)
  speed     Int?     @map("speed") @db.SmallInt
  status    Int      @map("status") @db.SmallInt
  longitude Float
  latitude  Float
  location  Unsupported("geometry(point, 4326)")?
  dataTime  DateTime @map("data_time") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([roadName, dataTime], map: "uq_road_traffic")
  @@index([longitude, latitude])
  @@map("road_traffic")
}

/// 지역 뉴스 (local_news)
model LocalNews {
  id          String   @id @default(dbgenerated("uuidv7()")) @map("local_news_id") @db.Uuid
  title       String   @map("title") @db.VarChar(300)
  summary     String?  @map("summary") @db.Text
  link        String   @map("link") @db.VarChar(500)
  source      String   @map("source") @db.VarChar(50)
  category    String   @map("category") @db.VarChar(20)
  regionCode  String   @map("region_code") @db.VarChar(10)
  publishedAt DateTime @map("published_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([regionCode, publishedAt])
  @@map("local_news")
}

/// 재난 알림 (disaster_alerts)
model DisasterAlert {
  id          String   @id @default(dbgenerated("uuidv7()")) @map("disaster_alert_id") @db.Uuid
  msgCn       String   @map("msg_cn") @db.Text
  rcptnRgnNm  String   @map("rcptn_rgn_nm") @db.VarChar(100)
  regYmd      String   @map("reg_ymd") @db.VarChar(10)
  emrgStepNm  String   @map("emrg_step_nm") @db.VarChar(20)
  dstSeNm     String   @map("dst_se_nm") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([rcptnRgnNm, regYmd])
  @@map("disaster_alerts")
}

// ------------------------------------------------------
// View 정의
// ------------------------------------------------------
view ViewUniqueUserGrid {
  nx Int
  ny Int

  // View는 PK가 없으므로, 유니크한 복합 키로 식별자를 지정해줍니다.
  @@unique([nx, ny])
  @@map("view_unique_user_grids")
}

view Sigungu {
  sidoNm   String  @map("sido_nm") @db.VarChar(40)
  sigKorNm String  @map("sig_kor_nm") @db.VarChar(40)
  geom     Unsupported("geometry(multipolygon, 4326)")

  @@map("sigungu")
}

// 사용자별 기상 정보 뷰 (weather_ultra_by_user_id)
view WeatherUltraByUserId {
  userId    String @map("user_id") @db.Uuid
  nx        Int    @db.SmallInt
  ny        Int    @db.SmallInt
  fcstDatetime DateTime @map("fcst_datetime") @db.Timestamp(6)
  t1h       Int?   @db.SmallInt
  rn1       Int?   @db.SmallInt
  sky       Int?   @db.SmallInt
  uuu       Int?   @db.SmallInt
  vvv       Int?   @db.SmallInt
  reh       Int?   @db.SmallInt
  pty       Int?   @db.SmallInt
  lgt       Int?   @db.SmallInt
  vec       Int?   @db.SmallInt
  wsd       Int?   @db.SmallInt

  @@unique([userId, fcstDatetime])
  @@map("weather_ultra_by_user_id")
}