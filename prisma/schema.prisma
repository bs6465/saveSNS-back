/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model weather_ultra_short_term_forecast {
  weather_ultra_short_term_forecast_id String   @id(map: "weather_ultra_short_term_forecast_pk") @default(dbgenerated("uuidv7()")) @db.Uuid
  nx                                   Int      @db.SmallInt
  ny                                   Int      @db.SmallInt
  base_datetime                        DateTime @db.Timestamp(6)
  fcst_datetime                        DateTime @db.Timestamp(6)
  t1h                                  Int?     @db.SmallInt
