  vvv                            Int?      @db.SmallInt
  vec                            Int?      @db.SmallInt
  wsd                            Int?      @db.SmallInt
  sky                            Int?      @db.SmallInt
  pty                            Int?      @db.SmallInt
  pop                            Int?      @db.SmallInt
  wav                            Int?      @db.SmallInt
  pcp                            Int?      @db.SmallInt
  reh                            Int?      @db.SmallInt
  sno                            Int?      @db.SmallInt
  tmn                            Int?      @db.SmallInt
  tmx                            Int?      @db.SmallInt
