  sky                                  Int?     @db.SmallInt
  uuu                                  Int?     @db.SmallInt
  vvv                                  Int?     @db.SmallInt
  reh                                  Int?     @db.SmallInt
  pty                                  Int?     @db.SmallInt
  lgt                                  Int?     @db.SmallInt
  vec                                  Int?     @db.SmallInt
  wsd                                  Int?     @db.SmallInt
  created_at                           DateTime @default(now()) @db.Timestamp(6)
  updated_at                           DateTime @default(now()) @db.Timestamp(6)

  @@unique([nx, ny, fcst_datetime], map: "uq_weather_forecast")
