# ============================================
# saveSNS 로컬 개발 환경 설정
# setup-local.ps1 실행 시 .env로 복사됩니다.
# ============================================

# Database Configuration (Docker Compose)
DB_USER=savesns_dev
DB_PASSWORD=savesns_dev_pw
DB_HOST=localhost
DB_PORT=5432
DB_NAME=savesns

# JWT Secret
JWT_SECRET_KEY=local-dev-secret-key-not-for-production

# Storage: 'local' (개발), 's3' (프로덕션)
STORAGE_TYPE=local

# Server
PORT=3000
NODE_ENV=development

# AWS S3 - 로컬 개발 시 STORAGE_TYPE=local이면 불필요
# AWS_REGION=ap-northeast-2
# AWS_S3_ACCESS_KEY_ID=AKIA2S2Y4IK4XCWLQR7D
# AWS_S3_SECRET_ACCESS_KEY=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
# AWS_S3_BUCKET_NAME=
# CLOUDFRONT_DOMAIN=
